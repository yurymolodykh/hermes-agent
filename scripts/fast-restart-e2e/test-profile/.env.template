# Isolated fast-restart e2e test profile — environment template.
#
# HERMES_HOME is a fresh temporary directory every run; the bootstrap writes
# this file there with generated throwaway keys.  The checked-in tree contains
# NO secrets.  There is deliberately NO reference to the production gateway
# port 8642 and NO telegram / yadisk credential variables — those platforms are
# not configured for this profile, so no real Telegram message can be sent and
# no yadisk upload can happen from it.
#
# Placeholders (substituted by bootstrap_test_profile.py):
#   API_SERVER_PORT is replaced with the test api_server port (default 18642).
#   API_SERVER_KEY and MOCK_API_KEY are replaced with random throwaway keys.
#
# The comment block intentionally uses plain prose instead of the exact
# placeholder tokens so the generated .env stays free of secret-shaped text.

API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=__API_PORT__
API_SERVER_KEY=__API_KEY__
MOCK_API_KEY=__MOCK_KEY__
HERMES_CRON_TIMEOUT=600
